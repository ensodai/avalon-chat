# ==============================================================================
# 🌐 Avalon Avatars - Self-Hosted Environment Configuration
# ==============================================================================
# Скопируйте этот файл в .env и укажите ваши настройки:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 📱 Client Configuration (Android App / Web Wasm / Desktop)
# ------------------------------------------------------------------------------
# Базовый URL бэкенда для клиентских сборок.
# - Для Android-эмулятора по умолчанию: http://10.0.2.2:8080
# - Для Web / Desktop / локальной сети: http://localhost:8080 или http://192.168.x.x:8080
# - Для боевого сервера (Production): https://your-domain.com
APP_SERVER_BASE_URL=http://10.0.2.2:8080

# Опционально: кастомные WebSocket URL (если не указаны, выводятся автоматически из APP_SERVER_BASE_URL)
# APP_SERVER_SYNC_WS_URL=ws://10.0.2.2:8080/
# APP_SERVER_LIVE_CALL_WS_URL=ws://10.0.2.2:8080/

# ------------------------------------------------------------------------------
# 🖥️ Server Configuration (:server)
# ------------------------------------------------------------------------------
# Серверный порт (по умолчанию 8080)
PORT=8080

# Базовый URL сервера для формирования публичных ссылок на медиафайлы (uploads)
SERVER_BASE_URL=http://localhost:8080

# База данных PostgreSQL 17+
DB_HOST=localhost
DB_PORT=5432
DB_NAME=avalon_chat
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Redis Cache (Опционально / Рекомендуется)
REDIS_URL=redis://localhost:6379

# JWT Секрет для авторизации сессий
# Если оставить пустым, сервер автоматически сгенерирует криптографический ключ при первом запуске и запишет в .env
JWT_SECRET=

# ------------------------------------------------------------------------------
# 🤖 AI Provider Keys (Self-Hosted / BYOK)
# ------------------------------------------------------------------------------
# Ключ Google Gemini API (для стандартных моделей)
SPECIAL_GEMINI_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 🔒 Безопасность и регистрация
# ------------------------------------------------------------------------------
# Разрешить открытую регистрацию пользователей в приложении (true / false)
# Если false, регистрация доступна только администратору через Telegram-бота
ALLOW_PUBLIC_REGISTRATION=true

# ------------------------------------------------------------------------------
# 📢 Telegram Bot для администрирования (Опционально)
# ------------------------------------------------------------------------------
# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram Chat ID (из @userinfobot) для доступа к админ-панели
TELEGRAM_ADMIN_ID=0

